# profile.yaml — RIFF personalization layer
#
# This file is committed as an example. Your real profile.yaml is gitignored.
#
# To set up your own:
#   1. Run /riff:onboard from inside the framework directory in Claude Code.
#      It will walk you through 15 questions or let you pick a preset.
#   2. Or copy this file to profile.yaml and edit by hand.
#
# Every RIFF agent reads the resolved profile at startup and adapts its
# persona, strictness, length, and budget.
#
# Resolution order (first found wins):
#   1. <project_root>/.planning/profile.yaml  — per-project override
#   2. <framework_root>/profile.yaml           — global default (this file's location)
#   3. neutre preset                           — when both are missing
#
# Project override is full-replace (no field-by-field merge). Use it for
# genuinely divergent setups (stricter client work, different language,
# workshop demo). Most projects keep the global default.
# Full rule: references/PROFILE-RESOLUTION.md
#
# Schema and field meanings: commands/onboard.md § Profile schema
# Other presets to start from: commands/onboard.md § Presets
#   - expert        → team specialist, terse, fast, jargon-free, balanced budget
#   - neutre        → safe middle ground (this file)
#   - apprentissage → learner-friendly: cautious, detailed, asks before acting
#   - alex          → solo + content + business, cautious + terse + max budget

user:
  programming_level: intermediate    # novice | learner | intermediate | experienced | expert
  ai_agents_experience: tried        # none | tried | regular | advanced
  domains: [generalist]              # frontend, backend, fullstack, data_ml, systems, mobile, generalist
  work_mode: solo                    # solo | team | solo_plus_clients | client_work | mix
  side_activities: [none]            # none, content, business, design, ops, other
  conversational_language: en        # en | fr | mix | any ISO 639-1 code (es, ro, de, …). Default: en
  artifact_language: en              # en | fr | any ISO 639-1 code. Default: en (code, commits, docs)

risk:
  sensitive_task_preference: balanced  # cautious | balanced | fast

style:
  length: standard                   # terse | standard | detailed
  allow_jargon: first_mention        # free | first_mention | never
  when_uncertain: important_only     # always_ask | important_only | initiative
  explanation_level: simple          # technical | simple | eli5
                                     # technical: name functions/files/types/paths, tech vocab assumed, implementation details welcome
                                     # simple: plain words, replace tech terms with what they mean, focus on what changed (recommended)
                                     # eli5: analogy-based, 2-4 sentences, zero tech vocab. Useful in the dashboard for non-technical observers.
                                     # Drives both /riff:dashboard explanations AND how Claude reports work, bugs, and operations in the terminal.
                                     # eli5 collapses to simple in the terminal unless overridden below (analogies don't fit terminal contexts).
  # terminal_explanation_level: technical
                                     # OPTIONAL override for terminal output only. Same values as above.
                                     # Set this if you want simple/eli5 in the dashboard but technical depth in the terminal.

budget:
  default_quality: balanced          # frugal | balanced | max

notifications:
  channel: none                      # none | telegram | slack | email
  # slack_webhook: https://hooks.slack.com/services/...   # required when channel=slack
  # email_to: you@example.com                             # required when channel=email
                                     # telegram uses the bundled n8n webhook (no extra config).
                                     # email tries `gws gmail` first, falls back to system `mail`.
                                     # If a required sub-field is missing, notify-human.sh skips + warns (never fails the phase).

git:
  merge_strategy: github_button      # github_button | local_no_ff
                                     # github_button: I click Merge on GitHub myself; Step 0 reconciles next /riff:next run.
                                     # local_no_ff: RIFF merges locally on "merge" cue. Better for solo work where main may have unpushed personal commits.

dashboard:
  language: en                       # en | fr | other
                                     # If unset, falls back to user.conversational_language when fr/en, else en.
  projects: []                       # registry of RIFF projects to display in the dashboard.
                                     # Absolute paths only. Auto-populated by /riff:start.
                                     # Add/remove from the dashboard UI, or edit by hand.
                                     # Example:
                                     #   - /Users/me/DEV/personal-projects/my-app
                                     #   - /Users/me/DEV/clients-projects/acme/website
                                     #
                                     # NOTE: legacy `dashboard.level` is still read for back-compat.
                                     # New profiles should use `style.explanation_level` instead.
