#!/usr/bin/env node
import { fileURLToPath } from 'node:url';
import { dirname, resolve } from 'node:path';
import { realpathSync } from 'node:fs';
import { spawnSync } from 'node:child_process';

const frameworkRoot = dirname(realpathSync(resolve(fileURLToPath(import.meta.url))));

const command = process.argv[2];

if (!command || command === '-h' || command === '--help') {
  process.stdout.write(`RIFF CLI

Usage:
  riff init [options]
  riff next --phase <id> --task <description> [options]
  riff debug --issue <text> [--intensity normal|high|max] [options]
  riff wave --autonomous [--loop] [options]
  riff finish --check [--run ID] [--project-root PATH] [--base BRANCH] [--json]
  riff finish --confirm TOKEN [--run ID] [--project-root PATH] [--base BRANCH] [--json]
  riff phase <list|add|set-status> [options]
  riff status [--json]
  riff resync
  riff doctor
  riff dashboard [--stop]
  riff linear <setup>

Commands:
  init      Install RIFF into the current project
  next      Run one bounded native stage using runtime.provider from the active profile
  debug     Diagnose an explicit issue read-only, then run one bounded native fix when diagnosed
  wave      Run ready roadmap phases autonomously; add --loop to continue until a stop condition
  finish    Build a token-bound Git finish plan, then commit and integrate only after confirmation
  phase     List, add, or update roadmap phases
  status    Show roadmap, active wave, native stage, and next action
  resync    Reconcile RIFF-owned Claude and Codex runtime adapters and skills
  doctor    Lint RIFF framework references and profile schema reads
  dashboard Start (or attach to) the local web dashboard for the current project (--stop to terminate)
  linear    Sync the roadmap with Linear (run "riff linear" for subcommands)

Options for init:
  --scope <production|scratch>
  --project-root <path>
  --profile <preset|custom|skip>
  --no-onboard
  --force
`);
  process.exit(command ? 0 : 1);
}

if (command === 'resync') {
  const result = spawnSync('bash', [resolve(frameworkRoot, 'riff-resync.sh')], { stdio: 'inherit' });
  process.exit(result.status ?? 1);
}

if (command === 'next') {
  const result = spawnSync('node', [resolve(frameworkRoot, 'scripts', 'riff-next.mjs'), ...process.argv.slice(3)], { stdio: 'inherit' });
  process.exit(result.status ?? 1);
}

if (command === 'debug') {
  const result = spawnSync('node', [resolve(frameworkRoot, 'scripts', 'riff-debug.mjs'), ...process.argv.slice(3)], { stdio: 'inherit' });
  process.exit(result.status ?? 1);
}

if (command === 'wave') {
  const result = spawnSync('node', [resolve(frameworkRoot, 'scripts', 'riff-wave.mjs'), ...process.argv.slice(3)], { stdio: 'inherit' });
  process.exit(result.status ?? 1);
}

if (command === 'finish') {
  const result = spawnSync('node', [resolve(frameworkRoot, 'scripts', 'riff-finish.mjs'), ...process.argv.slice(3)], { stdio: 'inherit' });
  process.exit(result.status ?? 1);
}

if (command === 'phase') {
  const result = spawnSync('node', [resolve(frameworkRoot, 'scripts', 'riff-phase.mjs'), ...process.argv.slice(3)], { stdio: 'inherit' });
  process.exit(result.status ?? 1);
}

if (command === 'status') {
  const result = spawnSync('node', [resolve(frameworkRoot, 'scripts', 'riff-status.mjs'), ...process.argv.slice(3)], { stdio: 'inherit' });
  process.exit(result.status ?? 1);
}

if (command === 'doctor') {
  const result = spawnSync('node', [resolve(frameworkRoot, 'scripts', 'riff-doctor.mjs'), ...process.argv.slice(3)], { stdio: 'inherit' });
  process.exit(result.status ?? 1);
}

if (command === 'dashboard') {
  const result = spawnSync('bash', [resolve(frameworkRoot, 'scripts', 'dashboard.sh'), ...process.argv.slice(3)], {
    stdio: 'inherit',
    env: { ...process.env, RIFF_FRAMEWORK_ROOT: frameworkRoot },
  });
  process.exit(result.status ?? 1);
}

if (command === 'linear') {
  // Drop the `linear` token so linear-sync.mjs sees its subcommand at argv[2].
  process.argv.splice(2, 1);
  const linear = await import(resolve(frameworkRoot, 'scripts', 'linear-sync.mjs'));
  await linear.main();
} else if (command === 'init') {
  await import(resolve(frameworkRoot, 'scripts', 'riff-init.mjs'));
} else {
  process.stderr.write(`Unknown command: ${command}\n`);
  process.exit(1);
}
