#!/usr/bin/env node
import { fileURLToPath } from 'node:url';
import { dirname, resolve } from 'node:path';
import { realpathSync } from 'node:fs';
import { spawnSync } from 'node:child_process';

const frameworkRoot = dirname(realpathSync(resolve(fileURLToPath(import.meta.url))));

const command = process.argv[2];

if (!command || command === '-h' || command === '--help') {
  process.stdout.write(`RIFF CLI

Usage:
  riff init [options]
  riff resync
  riff doctor
  riff dashboard [--stop]
  riff linear <setup>

Commands:
  init      Install RIFF into the current project
  resync    Re-link the /riff:* slash commands (run once after cloning the framework, or after it adds/removes commands)
  doctor    Lint RIFF framework references and profile schema reads
  dashboard Start (or attach to) the local web dashboard for the current project (--stop to terminate)
  linear    Sync the roadmap with Linear (run "riff linear" for subcommands)

Options for init:
  --scope <production|scratch>
  --project-root <path>
  --profile <preset|custom|skip>
  --no-onboard
  --force
`);
  process.exit(command ? 0 : 1);
}

if (command === 'resync') {
  const result = spawnSync('bash', [resolve(frameworkRoot, 'riff-resync.sh')], { stdio: 'inherit' });
  process.exit(result.status ?? 1);
}

if (command === 'doctor') {
  const result = spawnSync('node', [resolve(frameworkRoot, 'scripts', 'riff-doctor.mjs'), ...process.argv.slice(3)], { stdio: 'inherit' });
  process.exit(result.status ?? 1);
}

if (command === 'dashboard') {
  const result = spawnSync('bash', [resolve(frameworkRoot, 'scripts', 'dashboard.sh'), ...process.argv.slice(3)], {
    stdio: 'inherit',
    env: { ...process.env, RIFF_FRAMEWORK_ROOT: frameworkRoot },
  });
  process.exit(result.status ?? 1);
}

if (command === 'linear') {
  // Drop the `linear` token so linear-sync.mjs sees its subcommand at argv[2].
  process.argv.splice(2, 1);
  const linear = await import(resolve(frameworkRoot, 'scripts', 'linear-sync.mjs'));
  await linear.main();
} else if (command === 'init') {
  await import(resolve(frameworkRoot, 'scripts', 'riff-init.mjs'));
} else {
  process.stderr.write(`Unknown command: ${command}\n`);
  process.exit(1);
}
