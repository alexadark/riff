  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/riff/voice-rules-inject.sh" }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/riff/voice-rules-inject.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/riff/dangerous-command-guard.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/riff/boundary-check.sh" },
          { "type": "command", "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/riff/typecheck-gate.sh" },
          { "type": "command", "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/riff/lint-gate.sh" },
          { "type": "command", "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/riff/test-gate.sh" }
        ]
      }
    ]
  }
